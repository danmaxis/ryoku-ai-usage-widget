{
  "id": "ai-usage",
  "name": "AI Usage",
  "version": "0.2.0",
  "author": "Danilo Heroso <danmaxis@gmail.com>",
  "description": "AI plan usage on the Ryoku desktop, from ai-usagebar: a detail surface listing every enabled provider grouped by account, each with its meter, its headline and a live countdown to its reset. Opens from the frame edge or a keybind. Read-only over the local `ai-usagebar usage --json` report; no credentials, no network of its own.",
  "license": "MIT",
  "official": false,
  "hosts": [
    "framePopout"
  ],
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml"
  },
  "files": [
    "content/i18n/en.json",
    "content/i18n/pt_BR.json",
    "content/i18n/pt.json",
    "content/i18n/es.json",
    "content/i18n/fr.json"
  ],
  "capabilities": {
    "densities": [
      "full"
    ]
  },
  "defaults": {
    "host": "framePopout",
    "label": "AI Usage"
  },
  "dependencies": {
    "commands": [
      "ai-usagebar"
    ]
  },
  "metadata": {
    "settings": [
      {
        "key": "language",
        "type": "choice",
        "label": "Language",
        "group": "Appearance",
        "default": "en",
        "options": [
          {
            "value": "auto",
            "label": "Auto"
          },
          {
            "value": "en",
            "label": "English"
          },
          {
            "value": "es",
            "label": "Español"
          },
          {
            "value": "fr",
            "label": "Français"
          },
          {
            "value": "pt",
            "label": "Português"
          },
          {
            "value": "pt_BR",
            "label": "Português (BR)"
          }
        ]
      },
      {
        "key": "accent",
        "type": "choice",
        "label": "Accent",
        "group": "Appearance",
        "default": "wallpaper",
        "options": [
          {
            "value": "wallpaper",
            "label": "Wallpaper"
          },
          {
            "value": "brand",
            "label": "Brand"
          },
          {
            "value": "mono",
            "label": "Monochrome"
          }
        ]
      },
      {
        "key": "order",
        "type": "choice",
        "label": "Provider order (headline usage %)",
        "group": "Data",
        "default": "upstream",
        "options": [
          {
            "value": "upstream",
            "label": "Upstream primary"
          },
          {
            "value": "highest",
            "label": "Highest headline % first"
          },
          {
            "value": "lowest",
            "label": "Lowest headline % first"
          },
          {
            "value": "alphabetical",
            "label": "Alphabetical"
          },
          {
            "value": "manual",
            "label": "Manual sequence (below)"
          }
        ]
      },
      {
        "key": "orderSequence",
        "type": "text",
        "label": "Manual sequence",
        "group": "Data",
        "placeholder": "anthropic,openai@work,copilot",
        "default": ""
      },
      {
        "key": "primary",
        "type": "text",
        "label": "Pinned provider",
        "group": "Data",
        "placeholder": "anthropic",
        "default": ""
      },
      {
        "key": "showMetricDetail",
        "type": "toggle",
        "label": "Show primary pace detail",
        "group": "Data",
        "default": true
      },
      {
        "key": "padding",
        "type": "slider",
        "label": "Padding",
        "group": "Layout",
        "min": 0,
        "max": 32,
        "decimals": 0,
        "default": 12
      },
      {
        "key": "gap",
        "type": "slider",
        "label": "Row gap",
        "group": "Layout",
        "min": 2,
        "max": 24,
        "decimals": 0,
        "default": 6
      },
      {
        "key": "secondaryLabel",
        "type": "choice",
        "label": "Secondary label",
        "group": "Layout",
        "default": "name",
        "options": [
          {
            "value": "name",
            "label": "Name"
          },
          {
            "value": "short",
            "label": "Short code"
          },
          {
            "value": "plan",
            "label": "Plan"
          }
        ]
      },
      {
        "key": "showSecondaries",
        "type": "toggle",
        "label": "Show secondary row",
        "group": "Layout",
        "default": true
      },
      {
        "key": "maxSecondary",
        "type": "slider",
        "label": "Sec. rows",
        "group": "Data",
        "min": 0,
        "max": 12,
        "decimals": 0,
        "default": 6
      },
      {
        "key": "pollSeconds",
        "type": "slider",
        "label": "Every (s)",
        "group": "Data",
        "min": 60,
        "max": 3600,
        "decimals": 0,
        "default": 300
      },
      {
        "key": "density",
        "type": "choice",
        "label": "Density",
        "group": "Layout",
        "default": "expanded",
        "options": [
          {
            "value": "expanded",
            "label": "Expanded (all metrics)"
          },
          {
            "value": "compact",
            "label": "Compact (one per provider)"
          }
        ]
      },
      {
        "key": "keybindHint",
        "type": "text",
        "label": "Keybind (toggle) - type in Keybinds",
        "group": "Keybind",
        "placeholder": "ryoku-shell plugin ai-usage",
        "default": ""
      }
    ]
  }
}
